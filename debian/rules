#!/usr/bin/make -f
%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:

override_dh_auto_build:
	dh_auto_build
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

override_dh_auto_install:
	dh_auto_install
	# Clean __pycache__ created during setup.py install into staging area
	find debian/tmp -type d -name __pycache__ -exec rm -rf '{}' + 2>/dev/null || true
